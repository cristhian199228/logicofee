    {
      "type": "table",
      "title": "Procesos activos (SHOW PROCESSLIST)",
      "description": "",
      "id": 17,
      "datasource": {
        "type": "mysql",
        "uid": "mysql"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT id, user, host, db, command, time AS segundos, state, LEFT(info, 150) AS consulta\nFROM information_schema.PROCESSLIST\nWHERE command <> 'Daemon'\nORDER BY time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "table",
      "title": "Top 10 consultas más costosas (performance_schema)",
      "description": "",
      "id": 18,
      "datasource": {
        "type": "mysql",
        "uid": "mysql"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT LEFT(DIGEST_TEXT, 150) AS consulta, COUNT_STAR AS ejecuciones,\n       ROUND(AVG_TIMER_WAIT/1e12, 4) AS promedio_seg, ROUND(MAX_TIMER_WAIT/1e12, 4) AS max_seg,\n       SUM_ROWS_EXAMINED AS filas_examinadas, SUM_NO_INDEX_USED AS sin_indice\nFROM performance_schema.events_statements_summary_by_digest\nWHERE SCHEMA_NAME = 'laravel'\nORDER BY SUM_TIMER_WAIT DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "table",
